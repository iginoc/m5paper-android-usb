# --- Operating System & Generic Files ---
.DS_Store
Thumbs.db
*.swp
*~
*.bak
*.tmp
*.log

# --- Android / Gradle Build Artifacts ---
.gradle/
**/build/
android/app/build/
android/build/
android/local.properties
android/.cxx/
android/.externalNativeBuild/

# Android Studio / IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
/captures/
.externalNativeBuild/
android/.idea/

# Android Generated Packages & Keys
*.apk
*.ap_
*.aab
*.dex
*.class
*.keystore
*.jks

# --- M5Paper / PlatformIO Artifacts ---
.pio/
.pioenvs/
.piolibdeps/
.clangd/
m5paper/.pio/
m5paper/.pioenvs/
m5paper/.piolibdeps/

# Compiled Binary Artifacts
*.elf
*.bin
*.hex
*.map
*.o
*.a
*.sconsign*

# --- VS Code & IDE Configurations ---
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
.vscode/*.log
m5paper/.vscode/
